# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# ⚠️ On Vercel: DO NOT set APP_URL to a different domain than the URL users
#    actually open. The code now derives the OAuth callback from the real
#    request host; APP_URL is only a fallback for hosts hidden behind a proxy
#    (e.g. Cloud Run). A wrong APP_URL causes "redirect_uri does not match".
# APP_URL="MY_APP_URL"

# Shared database (fixes: data not syncing across devices/accounts) ---------
# BORROW HUB stores users/items/requests/notifications in Upstash Redis so
# every device and every account sees the SAME data (previously it only used
# the browser's localStorage, which is per-device and per-browser).
#
# SETUP (one time):
#   1. Vercel Project -> Storage tab -> Create Database -> "Upstash Redis"
#      (Marketplace integration) -> Connect to this project.
#   2. Vercel injects these two variables into your project automatically.
#      Copy the same two values here for local development, and redeploy on
#      Vercel once after connecting so the live site picks them up.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# LINE Login OAuth Credentials
# NOTE (Vercel deployment): add these same variables in your Vercel Project →
# Settings → Environment Variables so the serverless functions (api/line-url.ts,
# api/line-callback.ts) can sign in users. The code falls back to the defaults
# below if they are missing, so the values must match your LINE channel.
LINE_CHANNEL_ID="2011554399"
LINE_CHANNEL_SECRET="90bc8c44027203495663b57c69fdb135"

# LINE Messaging API push — REQUIRED for real LINE OA push notifications
# ⚠️ THE "LINKING BOT" MODEL (when LINE Login and Messaging API are on
#    different channels you must link them so user IDs match):
#    1) Keep LINE_CHANNEL_ID / LINE_CHANNEL_SECRET = the LINE Login channel.
#    2) In LINE Developers Console → LINE Login channel → LINE Login tab →
#       "Linking bot" → enter the Messaging API (bot) channel ID.
#    3) LINECHANNEL_ACCESS_TOKEN below = the access token ISSUED FROM THE BOT
#       (Messaging API) channel. Only then pushes reach users who logged in.
#    Get the token from: Console → Bot channel → Messaging API tab →
#       "Channel access token (long-lived)" → "Issue".
#    Otherwise notifications stay in-app only (api/line/push returns 503).
# NOTE: push messages only reach users who have ADDED the bot's LINE OA as a
# friend. Publish the bot channel to allow everyone to add / receive.
LINE_CHANNEL_ACCESS_TOKEN=""
